{
  "name": "kush-house",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/audit-dist.mjs",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "assets": "node scripts/gen-assets.mjs",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "astro build",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.15.0",
    "@fontsource-variable/archivo": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.15.0",
    "eslint-plugin-astro": "^1.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^15.12.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
