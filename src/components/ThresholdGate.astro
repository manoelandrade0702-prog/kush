---
import { SITE } from '../lib/site';

/**
 * A one-per-session "curtain" over the home page. Progressive enhancement:
 * it ships `hidden`, so with JS off (or for repeat visitors, or under
 * reduced-motion) it never appears and the page is immediately usable.
 */
---

<div
  class="threshold"
  data-threshold
  role="dialog"
  aria-modal="true"
  aria-labelledby="threshold-title"
  hidden
>
  <div class="threshold__inner">
    <p class="eyebrow">{SITE.city}</p>
    <p id="threshold-title" class="threshold__word">KUSH<span>HOUSE</span></p>
    <p class="threshold__line text-dim">{SITE.tagline}</p>
    <button type="button" class="btn btn--primary threshold__enter" data-threshold-enter>
      Entrar
    </button>
  </div>
</div>

<style>
  .threshold {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: var(--gutter);
    text-align: center;
    background: var(--c-void);
  }

  .threshold[hidden] {
    display: none;
  }

  .threshold.is-leaving {
    transition: transform var(--dur-slow) var(--ease-in-out);
    transform: translateY(-100%);
  }

  .threshold__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-m);
  }

  .threshold__word {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--tracking-tight);
    line-height: 0.9;
    font-size: var(--step-6);
  }

  .threshold__word span {
    color: var(--text-dim);
  }

  .threshold__line {
    max-width: 28ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .threshold__inner > * {
      animation: threshold-rise var(--dur-slow) var(--ease-out) both;
    }

    .threshold__inner > *:nth-child(2) {
      animation-delay: 0.08s;
    }

    .threshold__inner > *:nth-child(3) {
      animation-delay: 0.16s;
    }

    .threshold__inner > *:nth-child(4) {
      animation-delay: 0.24s;
    }
  }

  @keyframes threshold-rise {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
  }
</style>

<script>
  const KEY = 'kh-threshold-seen';
  const gate = document.querySelector<HTMLElement>('[data-threshold]');

  function seen(): boolean {
    try {
      return sessionStorage.getItem(KEY) === '1';
    } catch {
      return false;
    }
  }

  function remember(): void {
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {
      /* private mode / storage disabled — fine, it just shows next load */
    }
  }

  if (gate) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const enterBtn = gate.querySelector<HTMLButtonElement>('[data-threshold-enter]');
    let dismissed = false;

    const dismiss = (): void => {
      if (dismissed) return;
      dismissed = true;
      remember();
      document.documentElement.classList.remove('is-modal');
      document.removeEventListener('keydown', onKeydown, true);

      const finish = (): void => {
        gate.hidden = true;
        document.getElementById('main')?.focus({ preventScroll: true });
      };

      if (reduce) {
        finish();
      } else {
        gate.classList.add('is-leaving');
        gate.addEventListener('transitionend', finish, { once: true });
        window.setTimeout(finish, 1000);
      }
    };

    function onKeydown(event: KeyboardEvent): void {
      if (event.key === 'Escape') {
        dismiss();
      } else if (event.key === 'Tab') {
        // single focus stop — keep focus on the button
        event.preventDefault();
        enterBtn?.focus();
      }
    }

    if (!seen() && !reduce) {
      gate.hidden = false;
      document.documentElement.classList.add('is-modal');
      enterBtn?.focus({ preventScroll: true });
      document.addEventListener('keydown', onKeydown, true);
      enterBtn?.addEventListener('click', dismiss);
      gate.addEventListener('click', (event) => {
        if (event.target === gate) dismiss();
      });
      window.setTimeout(dismiss, 6000);
    } else {
      remember();
    }
  }
</script>
