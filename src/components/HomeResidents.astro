---
import type { CollectionEntry } from 'astro:content';
import Marquee from './Marquee.astro';
import ArrowLink from './ArrowLink.astro';

interface Props {
  artists: CollectionEntry<'artists'>[];
  names: string[];
}

const { artists, names } = Astro.props;
---

<section id="residentes" class="section residents" aria-labelledby="residents-title">
  <Marquee items={names} />

  <div class="container residents__body">
    <header class="residents__head" data-reveal>
      <p class="eyebrow">Residentes</p>
      <h2 id="residents-title" class="residents__title">Quem segura a noite</h2>
      <p class="lede text-dim">
        Um núcleo fixo de selectors mais convidados a cada temporada. Toca de dub a techno sem pedir
        licença.
      </p>
    </header>

    <ul class="residents__grid" role="list">
      {
        artists.map((artist) => (
          <li data-reveal>
            <a class="resident" href="/artists">
              <span class="resident__frame">
                {artist.data.photo ? (
                  <img
                    src={artist.data.photo}
                    alt=""
                    width="480"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="resident__frame-fallback" aria-hidden="true" />
                )}
              </span>
              <span class="resident__name">{artist.data.name}</span>
              <span class="resident__role text-dim">{artist.data.role}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="residents__more" data-reveal>
      <ArrowLink href="/artists">Ver todos os residentes</ArrowLink>
    </p>
  </div>
</section>

<style>
  .residents__body {
    margin-top: var(--space-2xl);
  }

  .residents__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .residents__title {
    font-size: var(--step-4);
  }

  .residents__grid {
    display: grid;
    gap: var(--space-l) var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    margin: 0;
  }

  .resident {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    text-decoration: none;
    color: var(--text);
  }

  .resident__frame {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: var(--hairline) solid var(--surface-border);
    border-radius: var(--radius);
    margin-bottom: var(--space-2xs);
    background: var(--bg-inset);
  }

  .resident__frame img,
  .resident__frame-fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) contrast(1.05);
    transition:
      transform var(--dur) var(--ease-out),
      filter var(--dur) var(--ease-out);
  }

  .resident__frame-fallback {
    display: block;
    background:
      radial-gradient(
        120% 80% at 80% 0%,
        color-mix(in oklab, var(--accent-2) 30%, transparent),
        transparent 60%
      ),
      linear-gradient(160deg, var(--bg-inset), var(--c-void));
  }

  .resident:hover .resident__frame img,
  .resident:focus-visible .resident__frame img {
    transform: scale(1.04);
    filter: grayscale(0) contrast(1.05);
  }

  .resident__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }

  .resident__role {
    font-family: var(--font-display);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .residents__more {
    margin-top: var(--space-xl);
  }
</style>
