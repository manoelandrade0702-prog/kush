---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
}

const { href, external = false, class: className } = Astro.props;
const isHttp = external || /^https?:\/\//.test(href);
---

<a
  class:list={['arrow-link', className]}
  href={href}
  rel={isHttp ? 'noopener noreferrer' : undefined}
  target={isHttp ? '_blank' : undefined}
>
  <span><slot />{isHttp && <span class="visually-hidden"> (abre em nova aba)</span>}</span>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="square"
      d="M4 12h13M12 6l6 6-6 6"></path>
  </svg>
</a>
