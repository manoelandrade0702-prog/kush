---
/**
 * Emits one or more JSON-LD blocks. `type="application/ld+json"` is not
 * executable, so it is exempt from `script-src` — no CSP concern.
 */
type Json = Record<string, unknown>;

interface Props {
  schema: Json | Json[];
}

const { schema } = Astro.props;
const blocks: Json[] = Array.isArray(schema) ? schema : [schema];

/** Prevent an embedded "</script>" in a string value from closing the tag. */
function serialise(data: Json): string {
  return JSON.stringify(data).replace(/</g, '\\u003c');
}
---

{blocks.map((block) => <script type="application/ld+json" is:inline set:html={serialise(block)} />)}
